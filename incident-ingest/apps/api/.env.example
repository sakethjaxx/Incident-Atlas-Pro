DATABASE_URL="postgresql://postgres:postgres@localhost:5432/incident_ingest?schema=public"
PORT=3001

# SEC-1: Restrict CORS to this origin (comma-separated for multiple).
# In dev this defaults to http://localhost:5173 if unset.
CORS_ORIGIN="http://localhost:5173"

# SEC-2: API key required in the x-ingest-api-key header for POST /ingest/manual.
# Leave empty in dev to skip the check (a warning will be logged).
INGEST_API_KEY=""
ADMIN_TOKEN="dev-secret"
REDIS_URL="redis://localhost:6379"

# Maximum files accepted in one multipart /ingest/upload request.
MAX_UPLOAD_FILES=20

# ── Open-source RAG stack (Sprint 5) ─────────────────────────────────────────
# No Anthropic / No OpenAI. All model serving is local & open source.
# See docs/OPEN_SOURCE_RAG_STACK.md for the full matrix.

# Embeddings: local (deterministic hash, offline) | bge (semantic default) | ollama
# bge → in-process ONNX via @huggingface/transformers (already in pnpm workspace).
# First run downloads BAAI/bge-small-en-v1.5 (~24 MB) to ~/.cache/huggingface/hub/.
# Switch back to local for air-gapped / offline environments.
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
# Stronger multilingual option (serve with Ollama):
#   EMBEDDING_PROVIDER=ollama
#   EMBEDDING_MODEL=bge-m3
#   EMBEDDING_DIMENSIONS=1024

# QA generation: local (extractive, default) | ollama (Qwen3-4B-Instruct)
QA_PROVIDER=local
QA_MODEL=qwen3:4b

# Graph extraction: rules (deterministic, default) | ollama (strict JSON via Qwen)
GRAPH_EXTRACTOR=rules
GRAPH_MODEL=qwen3:4b

# Reranker: none (default) | local (token overlap) | bge (BAAI/bge-reranker-base
# served over HTTP using the TEI /rerank contract; falls back to local on error)
RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-base
# RERANKER_URL=http://localhost:8080

# Ollama server (used by any provider set to "ollama")
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=60000

# Retrieval backend: pgvector (stable baseline) | turboquant (EXPERIMENTAL) | hybrid
# See docs/TURBOQUANT_RAG_PLAN.md before enabling TurboQuant.
RETRIEVAL_BACKEND=pgvector
TURBOQUANT_ENABLED=false
TURBOQUANT_BITS=4
TURBOQUANT_ROTATION=hadamard
TURBOQUANT_RESIDUAL_QJL=true
TURBOQUANT_SEED=1337
