VITE_API_URL="http://localhost:3001"
# Previous Next.js env var (no longer used by the SPA):
# NEXT_PUBLIC_API_URL="http://localhost:3001"

# Optional — Bearer token sent to POST /ingest/upload.
# Only required when the API server has ADMIN_TOKEN set (production/staging).
# Leave blank (or unset) for local dev — the backend allow-lists unauthenticated
# uploads when ADMIN_TOKEN is not configured.
VITE_ADMIN_TOKEN=
