{
  "name": "@app/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/worker.js",
    "dev": "node --watch src/worker.js",
    "reindex": "node src/reindex.js",
    "reindex:dry-run": "node src/reindex.js --dry-run",
    "test": "vitest run src/tests --reporter=verbose",
