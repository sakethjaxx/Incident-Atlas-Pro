  },
  "dependencies": {
    "@pkg/nlp": "workspace:*",
    "@prisma/client": "^5.18.0",
    "bullmq": "^5.7.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "vitest": "^2.1.9"
  }
}
