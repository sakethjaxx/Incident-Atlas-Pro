node_modules
dist
.next
.DS_Store

# CFG-1: Ignore .env at root AND inside any sub-package directory.
.env
.env.prod
.env.local
.env.*.local
apps/**/.env
apps/**/.env.local
apps/**/.env.*.local

# Runtime uploads are persisted via Docker volumes in production.
uploads/

# Benchmark/eval outputs are local artifacts, never committed.
artifacts/
*.log

# Ignore new files under docs/ by default ("docs/*" not "docs/" so individual
# files can still be negated below — git cannot re-include inside an ignored dir).
docs/*
# Sprint 5 public docs are tracked despite the docs ignore above.
!docs/OPEN_SOURCE_RAG_STACK.md
!docs/TURBOQUANT_RAG_PLAN.md
