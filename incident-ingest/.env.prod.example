# Production environment variables for Incident Atlas Pro
#
# Usage:
#   cp .env.prod.example .env.prod
#   # Fill in all required values, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build --wait
#
# NEVER commit .env.prod to source control.
# Use a secrets manager (Vault, Doppler, AWS Secrets Manager) in real production.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Required. No defaults — compose will refuse to start without these.
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=incident_ingest

# ── Redis ─────────────────────────────────────────────────────────────────────
# Required. Redis is started with --requirepass using this value.
REDIS_PASSWORD=change_me_redis_password

# ── API ───────────────────────────────────────────────────────────────────────
# Required. Used by requireAdmin middleware to protect upload and source routes.
ADMIN_TOKEN=change_me_admin_token

# Host port the API is exposed on. Default: 3001.
API_PORT=3001

# Maximum files accepted in one multipart /ingest/upload request. Default: 20.
MAX_UPLOAD_FILES=20

# Allowed CORS origin for the web frontend.
# In production this should be your actual frontend domain, not localhost.
CORS_ORIGIN=https://your-frontend-domain.com

# ── Worker ────────────────────────────────────────────────────────────────────
# Number of concurrent BullMQ jobs the worker processes. Default: 2.
WORKER_CONCURRENCY=2

# ── Open-source RAG stack (Sprint 5) ─────────────────────────────────────────
# No Anthropic / No OpenAI. See docs/OPEN_SOURCE_RAG_STACK.md.
# Defaults are the safest production choices: pgvector baseline retrieval,
# deterministic local fallbacks, no external model dependency required.
# bge runs in-process (ONNX) — no Ollama required. First start downloads
# BAAI/bge-small-en-v1.5 (~24 MB) to $HF_HOME or ~/.cache/huggingface/hub.
# Set EMBEDDING_PROVIDER=local for fully air-gapped deployments.
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
QA_PROVIDER=local
QA_MODEL=qwen3:4b
GRAPH_EXTRACTOR=rules
GRAPH_MODEL=qwen3:4b
RERANKER_PROVIDER=none
# RERANKER_URL=http://your-tei-host:8080
# Point at your self-hosted Ollama if enabling ollama providers:
OLLAMA_URL=http://localhost:11434
OLLAMA_TIMEOUT_MS=60000
# pgvector is the production retrieval path. TurboQuant is EXPERIMENTAL —
# keep disabled in production until docs/TURBOQUANT_RAG_PLAN.md criteria pass.
RETRIEVAL_BACKEND=pgvector
TURBOQUANT_ENABLED=false
TURBOQUANT_BITS=4
TURBOQUANT_ROTATION=hadamard
TURBOQUANT_RESIDUAL_QJL=true
TURBOQUANT_SEED=1337

# ── Web (build-time) ──────────────────────────────────────────────────────────
# These are NOT read by docker-compose — they must be set when building the
# web SPA (pnpm --filter @app/web build) or passed to your CDN/hosting config.
#
# VITE_API_URL=https://your-api-domain.com
# VITE_ADMIN_TOKEN=change_me_admin_token  # same value as ADMIN_TOKEN above
